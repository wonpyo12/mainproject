# Server
PORT=3000
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# MySQL (Spring Boot와 동일한 DB 공유)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cartpilot_db
DB_USER=root
DB_PASSWORD=yourpassword

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 로봇(라파) cmd_server — 정지/복귀 신호 TCP 전송 대상 (IP 자주 바뀜)
PI_HOST=192.168.0.67
PI_CMD_PORT=9998
